{
  "name": "@davidaayers/opencode-codex-usage-plugin",
  "version": "0.1.1",
  "description": "OpenCode TUI plugin that shows Codex quota usage gauges and reset times.",
  "keywords": [
    "codex",
    "opencode",
    "opencode-plugin",
    "tui",
    "usage"
  ],
  "homepage": "https://github.com/davidaayers/opencode-codex-usage-plugin#readme",
  "bugs": {
    "url": "https://github.com/davidaayers/opencode-codex-usage-plugin/issues"
  },
  "license": "MIT",
  "author": "David Ayers",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davidaayers/opencode-codex-usage-plugin.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    "./tui": {
      "types": "./dist/tui.d.ts",
      "import": "./dist/tui.js",
      "default": "./dist/tui.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "pnpm clean && tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "format": "oxfmt . --write",
    "format:check": "oxfmt . --check",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build",
    "prepare": "effect-language-service patch",
    "test": "vitest run src",
    "test:render": "npx --yes bun@1.4.3 --conditions=browser tests/render.mjs",
    "test:discovery": "node tests/discovery.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit --incremental false"
  },
  "dependencies": {
    "@opentui/solid": "0.5.17",
    "effect": "4.0.1",
    "solid-js": "1.9.12"
  },
  "devDependencies": {
    "@opencode/plugin": "2.0.29",
    "@opencode/theme": "2.0.29",
    "@effect/language-service": "0.86.2",
    "@effect/vitest": "4.0.1",
    "@types/node": "^24.10.1",
    "effect-solutions": "^0.5.3",
    "oxfmt": "^0.56.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  },
  "engines": {
    "opencode": ">=2.0.29"
  },
  "packageManager": "pnpm@10.33.0"
}
